---
import { Image } from 'astro:assets';
import { stats, capturas } from '../data/propuesta';
---

<section class="block" id="resultados">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Resultados reales</span>
        <h2>Números de videos que ya grabamos.</h2>
      </div>
      <p>Estas son métricas tomadas directamente de Instagram y TikTok, de negocios locales para los que producimos contenido.</p>
    </div>

    <div class="proof-grid">
      {stats.map((s) => (
        <div class="stat"><b class="num">{s.valor}</b><span>{s.texto}</span><em>{s.red}</em></div>
      ))}
    </div>

    <div class="shots">
      {capturas.map((c) => (
        <figure class="shot">
          <div class="frame"><Image src={c.imagen} alt={c.alt} width={560} /></div>
          <figcaption><strong>{c.destacado}</strong> {c.texto}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .proof-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 2px solid var(--ink); }
  .stat { padding: 22px 20px 6px 0; border-right: 1px solid var(--line); min-width: 0; }
  .stat + .stat { padding-left: 20px; }
  .stat:last-child { border-right: 0; }
  .stat b { display: block; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 3.6vw, 2.9rem); letter-spacing: -0.03em; line-height: 1.05; }
  .stat span { display: block; font-size: .95rem; color: var(--muted); margin-top: 8px; }
  .stat em { font-style: normal; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; display: inline-block; margin-top: 10px; color: var(--ink); }
  .shots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }
  .shot { margin: 0; min-width: 0; }
  .frame { border-radius: 16px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); aspect-ratio: 543 / 900; max-width: 100%; }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  figcaption { font-size: .9rem; color: var(--muted); margin-top: 12px; }
  figcaption strong { color: var(--ink); }

  @media (max-width: 900px) {
    .proof-grid { grid-template-columns: 1fr 1fr; }
    .stat { border-right: 0; border-bottom: 1px solid var(--line); padding: 20px 12px 18px 0 !important; }
    .stat:nth-child(even) { padding-left: 16px !important; border-left: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .shots { grid-template-columns: 1fr 1fr; }
    .shot:nth-child(3) { display: none; }
  }
</style>
