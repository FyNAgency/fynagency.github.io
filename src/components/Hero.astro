---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import videoGranos from '../assets/video-granos.jpg';
import videoSopa from '../assets/video-sopa.jpg';
import videoBurger from '../assets/video-burger.jpg';
---

<section class="hero">
  <div class="wrap">
    <div>
      <span class="eyebrow"><span class="rec-dot" aria-hidden="true"></span> Contenido vertical para tu negocio</span>
      <h1>Contenido que hace crecer <mark>tu negocio</mark>.</h1>
      <p class="lede">Creamos la estrategia, vamos a tu negocio a grabar, editamos y publicamos. Tú te enfocas en atender a los clientes que llegan.</p>
      <div class="hero-ctas">
        <a class="btn btn-aji" href="#paquetes">Ver paquetes <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href="#resultados">Ver resultados</a>
      </div>
    </div>
    <div class="reel" aria-label="Videos producidos por F&N agency">
      <div class="viewfinder" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div class="phone p-left">
        <Image src={videoGranos} alt="Video en un local de granos, 85,9 mil reproducciones en TikTok" width={500} loading="eager" />
      </div>
      <div class="phone p-mid">
        <Image src={videoSopa} alt="Video en un restaurante de sopas, 1,7 millones de reproducciones" width={535} loading="eager" fetchpriority="high" />
        <span class="tag"><span class="rec-dot" aria-hidden="true"></span>REC 00:42</span>
      </div>
      <div class="phone p-right">
        <Image src={videoBurger} alt="Video en una hamburguesería, 558 mil reproducciones" width={500} loading="eager" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero .wrap { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; padding-block: 72px 64px; }
  h1 { font-size: clamp(2.6rem, 6.4vw, 5.2rem); font-weight: 800; margin-top: 18px; }
  mark { background: linear-gradient(transparent 58%, var(--aji) 58% 92%, transparent 92%); color: inherit; padding: 0 2px; }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 34ch; margin-top: 22px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }

  .reel { position: relative; display: flex; justify-content: center; align-items: center; min-height: 460px; }
  .p-left { transform: rotate(-7deg) translateX(28%); z-index: 1; width: 40%; }
  .p-mid { z-index: 3; }
  .p-right { transform: rotate(7deg) translateX(-28%); z-index: 2; width: 40%; }
  .tag {
    position: absolute; left: 10px; top: 10px; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .08em;
    background: rgba(0,0,0,.6); color: #fff; padding: 4px 8px; border-radius: 6px; display: flex; gap: 6px; align-items: center;
  }
  .tag .rec-dot { width: 7px; height: 7px; background: #FF4A3D; }
  .viewfinder { position: absolute; inset: 0; pointer-events: none; }
  .viewfinder i { position: absolute; width: 26px; height: 26px; border-color: var(--muted); border-style: solid; opacity: .6; }
  .viewfinder i:nth-child(1) { top: 0; left: 4%; border-width: 2px 0 0 2px; }
  .viewfinder i:nth-child(2) { top: 0; right: 4%; border-width: 2px 2px 0 0; }
  .viewfinder i:nth-child(3) { bottom: 0; left: 4%; border-width: 0 0 2px 2px; }
  .viewfinder i:nth-child(4) { bottom: 0; right: 4%; border-width: 0 2px 2px 0; }

  @media (prefers-reduced-motion: no-preference) {
    .reel .phone { animation: rise .8s cubic-bezier(.2,.8,.2,1) both; }
    .reel .p-mid { animation-delay: .08s; }
    .reel .p-right { animation-delay: .16s; }
    @keyframes rise { from { translate: 0 24px; } to { translate: 0 0; } }
  }
  @media (max-width: 900px) {
    .hero .wrap { grid-template-columns: 1fr; padding-block: 32px 48px; gap: 32px; }
    .reel { order: -1; min-height: 380px; }
  }
  @media (max-width: 560px) {
    .reel { min-height: 320px; }
  }
  @media print {
    .reel .phone { animation: none !important; }
  }
</style>
