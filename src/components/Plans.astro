---
import Icon from './Icon.astro';
import { paquetes, pesos, costoPorVideo } from '../data/propuesta';

const diario = (n: number) => (n === 1 ? '1 video diario' : `${n} videos diarios`);
---

<section class="block" id="paquetes">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Inversión mensual</span>
        <h2>Elige el ritmo de contenido para tu negocio.</h2>
      </div>
      <p>Los tres paquetes incluyen estrategia personalizada, grabación estratégica, edición y publicación.</p>
    </div>

    <div class="plans">
      {paquetes.map((p) => (
        <article class:list={['plan', { featured: p.recomendado }]}>
          {p.recomendado && <span class="badge">Recomendado</span>}
          <div>
            <div class="plan-name">{p.nombre}</div>
            <h3>{p.videosMes} <small>videos al mes</small></h3>
            <p class="muted">{diario(p.videosDia)}</p>
          </div>
          <div>
            <div class="price num">{pesos(p.precio)} <small>COP / mes</small></div>
            <p class="per">Equivale a <b>{costoPorVideo(p)}</b> por video</p>
          </div>
          <ul>
            <li><Icon name="check" />Estrategia de contenido personalizada</li>
            <li><Icon name="check" />{p.visitas} visitas de grabación al mes</li>
            <li><Icon name="check" />Edición y publicación de cada video</li>
            {p.serieFabio && (
              <li class="bonus"><Icon name="star" /><span><strong>Incluye serie con @Fabio Parra:</strong> una visita al mes para grabar {p.serieFabio} que impulsan tu marca con su público.</span></li>
            )}
          </ul>
          <div class="spacer"></div>
          <a class="btn" href="#cierre" data-plan={p.nombre}>Quiero el {p.nombre}</a>
        </article>
      ))}
    </div>

    <div class="compare" role="region" aria-label="Comparación de paquetes" tabindex="0">
      <table>
        <thead>
          <tr>
            <th scope="col">Incluye</th>
            {paquetes.map((p) => <th scope="col" class:list={{ hl: p.recomendado }}>{p.nombre}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr><td>Videos al mes</td>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.recomendado ? <strong>{p.videosMes}</strong> : p.videosMes}</td>)}</tr>
          <tr><td>Videos al día</td>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.recomendado ? <strong>{p.videosDia}</strong> : p.videosDia}</td>)}</tr>
          <tr><td>Visitas de grabación</td>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.recomendado ? <strong>{p.visitas}</strong> : p.visitas}</td>)}</tr>
          <tr><td>Serie con @Fabio Parra</td>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.serieFabio ? <strong>{p.serieFabio}</strong> : '—'}</td>)}</tr>
          <tr><td>Costo por video</td>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.recomendado ? <strong>{costoPorVideo(p)}</strong> : costoPorVideo(p)}</td>)}</tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
  .plan {
    display: flex; flex-direction: column; gap: 22px; padding: 30px 26px; border-radius: 20px;
    background: var(--surface); border: 1px solid var(--line); min-width: 0; position: relative;
  }
  .plan.featured { background: var(--ink); color: var(--paper); border-color: var(--ink); transform: translateY(-14px); }
  .plan.featured .muted, .plan.featured .per { color: color-mix(in srgb, var(--paper) 72%, transparent); }
  .plan.featured li { border-color: color-mix(in srgb, var(--paper) 18%, transparent); }
  .badge {
    position: absolute; top: -13px; right: 22px; background: var(--aji); color: var(--on-aji);
    font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; font-weight: 500;
  }
  .plan-name { font-family: var(--font-mono); font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; }
  .plan h3 { font-size: 2.4rem; font-weight: 800; margin-top: 6px; }
  .plan h3 small { font-family: var(--font-body); font-size: .95rem; font-weight: 500; letter-spacing: 0; }
  .per { font-size: .9rem; color: var(--muted); margin-top: 8px; }
  .per b { font-variant-numeric: tabular-nums; }
  .plan ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .plan li { display: flex; gap: 10px; align-items: flex-start; padding: 11px 0; border-top: 1px solid var(--line); font-size: .97rem; }
  .plan li :global(svg) { flex: none; width: 18px; height: 18px; margin-top: 4px; }
  .plan li.bonus :global(svg) { color: var(--aji); }
  .plan li.bonus strong { color: var(--aji); }
  .spacer { flex: 1; }
  .plan .btn { justify-content: center; }
  .plan:not(.featured) .btn { border: 1.5px solid var(--ink); color: var(--ink); }
  .plan.featured .btn { background: var(--aji); color: var(--on-aji); }
  .plan .btn.is-picked { background: var(--aji); color: var(--on-aji); border-color: var(--aji); }

  .compare { margin-top: 44px; overflow-x: auto; border-radius: 16px; border: 1px solid var(--line); background: var(--surface); }
  table { width: 100%; border-collapse: collapse; min-width: 560px; font-size: .95rem; }
  th, td { text-align: left; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  tr:last-child td { border-bottom: 0; }
  thead th { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .hl { background: color-mix(in srgb, var(--aji) 18%, transparent); }
  td { font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .plans { grid-template-columns: 1fr; }
    .plan.featured { transform: none; }
  }
</style>
