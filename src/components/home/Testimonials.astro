---
import { testimonios, googleResenas } from '../../data/agencia';

// Published quotes must be confirmed by the client. Drafts only appear on the local dev server.
const visibles = import.meta.env.DEV ? testimonios : testimonios.filter((t) => t.aprobado);
const colores = ['#FFC21A', '#2F5BFF', '#FF9FCB', '#1FC99A'];
const claros = new Set(['#2F5BFF']);
---

{visibles.length > 0 && (
  <section class="testimonials" id="testimonios" aria-labelledby="testimonios-title">
    <div class="wrap head">
      <div>
        <span class="eyebrow" data-fade>Testimonios</span>
        <h2 id="testimonios-title" data-split>Lo que dicen<br />nuestros clientes.</h2>
      </div>
      <a class="btn btn-ink google" href={googleResenas || undefined} target={googleResenas ? '_blank' : undefined} rel={googleResenas ? 'noopener' : undefined}>Ver reseñas de Google</a>
    </div>
    <div class="wrap grid">
      {visibles.map((t, i) => {
        const bg = colores[i % colores.length];
        return (
          <figure class="quote" style={`--c: ${bg}; --on: ${claros.has(bg) ? '#FFFFFF' : '#0B0B0B'}`} data-term>
            {!t.aprobado && <span class="draft">Borrador · solo en local</span>}
            <blockquote>“{t.texto}”</blockquote>
            <figcaption>
              <b>{t.nombre}</b>
              <span>{t.negocio}</span>
              {t.enlace && <a href={t.enlace} target="_blank" rel="noopener">Ver reseña en Google</a>}
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>
)}

<style>
  .testimonials { padding-block: clamp(64px, 9vw, 120px); }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 22px; margin-bottom: clamp(32px, 4vw, 56px); }
  .head > div { display: grid; gap: 18px; min-width: 0; }
  .google { white-space: nowrap; }
  .google:not([href]) { cursor: default; }
  .google:not([href]):hover { transform: none; background: var(--ink); border-color: var(--ink); }
  h2 { font-size: clamp(2.4rem, 5.6vw, 5.4rem); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .quote { margin: 0; background: var(--c); color: var(--on); border-radius: 28px; padding: clamp(24px, 2.8vw, 36px); display: grid; gap: 22px; align-content: space-between; min-width: 0; }
  .draft { justify-self: start; background: #0B0B0B; color: #FFFFFF; font: 500 .68rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; }
  blockquote { margin: 0; font: 700 clamp(1.2rem, 1.7vw, 1.5rem)/1.3 var(--font-display); letter-spacing: -0.02em; }
  figcaption { display: grid; gap: 2px; justify-items: start; }
  figcaption span { font: 500 .72rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  figcaption a { margin-top: 10px; font-weight: 700; color: inherit; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .head { grid-template-columns: minmax(0, 1fr); justify-items: start; }
  }
</style>
