---
import { paquetes, pesos, costoPorVideo } from '../../data/agencia';

const estilo: Record<string, { bg: string; fg: string; dot: string; shape: string }> = {
  Básico: { bg: '#FFFFFF', fg: '#0B0B0B', dot: '#0B0B0B', shape: 'quarter' },
  Medio: { bg: '#2F5BFF', fg: '#FFFFFF', dot: '#FFC21A', shape: 'circle' },
  Premium: { bg: '#0B0B0B', fg: '#FFFFFF', dot: '#FFC21A', shape: 'leaf' },
};
const diario = (n: number) => (n === 1 ? '1 video diario' : `${n} videos diarios`);
const contactoHref = (nombre: string) => `/contacto?paquete=${encodeURIComponent(nombre)}`;
---

<section class="packages" id="paquetes">
  <div class="wrap head">
    <span class="eyebrow" data-fade>Paquetes · inversión mensual</span>
    <h2 data-split>Elige el ritmo<br />de tu contenido.</h2>
    <p data-fade>Los tres incluyen estrategia personalizada, grabación en tu local, edición y publicación. Cambia cuántas visitas hacemos y cuántos videos salen al mes.</p>
  </div>

  <div class="wrap cards">
    {paquetes.map((p) => {
      const e = estilo[p.nombre];
      return (
        <article class:list={['card', { featured: p.recomendado }]} style={`--bg: ${e.bg}; --fg: ${e.fg}; --dot: ${e.dot}`} data-package>
          {p.recomendado && <span class="badge">Recomendado</span>}
          <i class={`shape ${e.shape}`} aria-hidden="true"></i>
          <div class="name">{p.nombre}</div>
          <div class="videos"><b>{p.videosMes}</b><span>videos al mes<br />{diario(p.videosDia)}</span></div>
          <div class="price">{pesos(p.precio)} <small>COP / mes</small></div>
          <p class="per">Equivale a <b>{costoPorVideo(p)}</b> por video</p>
          <ul>
            <li>Estrategia de contenido personalizada</li>
            <li>{p.visitas} visitas de grabación al mes</li>
            <li>Edición y publicación de cada video</li>
            {p.serieFabio && <li class="bonus"><strong>Incluye serie con @Fabio Parra:</strong> una visita al mes para grabar {p.serieFabio}.</li>}
          </ul>
          <a class="pick" href={contactoHref(p.nombre)}>Quiero el {p.nombre}</a>
        </article>
      );
    })}
  </div>

  <div class="wrap">
    <div class="compare" role="region" aria-label="Comparación de paquetes" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">Incluye</th>{paquetes.map((p) => <th scope="col" class:list={{ hl: p.recomendado }}>{p.nombre}</th>)}</tr>
        </thead>
        <tbody>
          <tr><th scope="row">Videos al mes</th>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.videosMes}</td>)}</tr>
          <tr><th scope="row">Videos al día</th>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.videosDia}</td>)}</tr>
          <tr><th scope="row">Visitas de grabación</th>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.visitas}</td>)}</tr>
          <tr><th scope="row">Serie con @Fabio Parra</th>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{p.serieFabio ?? '—'}</td>)}</tr>
          <tr><th scope="row">Inversión mensual</th>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{pesos(p.precio)}</td>)}</tr>
          <tr><th scope="row">Costo por video</th>{paquetes.map((p) => <td class:list={{ hl: p.recomendado }}>{costoPorVideo(p)}</td>)}</tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .packages { padding-block: clamp(72px, 10vw, 140px); background: #FFF4D6; }
  .head { display: grid; gap: 18px; margin-bottom: clamp(36px, 5vw, 64px); }
  h2 { font-size: clamp(2.6rem, 6.4vw, 6.2rem); }
  .head p { color: var(--muted); max-width: 52ch; font-size: 1.08rem; }

  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-items: stretch; }
  .card {
    position: relative; overflow: hidden; background: var(--bg); color: var(--fg); border: 2px solid var(--ink);
    border-radius: 32px; padding: clamp(24px, 2.6vw, 34px); display: flex; flex-direction: column; gap: 16px;
  }
  .card.featured { transform: translateY(-16px); box-shadow: 0 30px 60px -30px rgba(11, 11, 11, .6); }
  .badge {
    position: absolute; top: 22px; right: 22px; z-index: 1; background: var(--yellow); color: var(--ink);
    font: 500 .72rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; padding: 6px 12px; border-radius: 999px;
  }
  .shape { position: absolute; width: 120px; aspect-ratio: 1; top: -30px; right: -30px; background: var(--yellow); opacity: .95; }
  .featured .shape { top: auto; bottom: -40px; right: -40px; width: 170px; background: var(--red); }
  .quarter { border-radius: 0 0 0 100%; }
  .circle { border-radius: 50%; background: var(--pink) !important; }
  .leaf { border-radius: 100% 0 100% 0; }
  .name { font: 500 .85rem var(--font-mono); letter-spacing: .16em; text-transform: uppercase; position: relative; }
  .videos { display: flex; align-items: flex-end; gap: 12px; position: relative; }
  .videos b { font: 800 clamp(3.6rem, 6vw, 5.4rem)/.85 var(--font-display); letter-spacing: -0.05em; }
  .videos span { font-weight: 600; line-height: 1.3; padding-bottom: 4px; }
  .price { font: 800 clamp(1.8rem, 2.6vw, 2.4rem)/1 var(--font-display); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; position: relative; }
  .price small { font: 500 .85rem var(--font-body); letter-spacing: 0; opacity: .8; }
  .per { font-size: .92rem; opacity: .85; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; position: relative; }
  li { padding: 10px 0 10px 26px; border-top: 1px solid color-mix(in srgb, var(--fg) 20%, transparent); position: relative; font-size: .97rem; }
  li::before { content: ""; position: absolute; left: 0; top: 17px; width: 12px; height: 12px; border-radius: 50%; background: var(--dot); }
  .bonus strong { color: var(--yellow); }
  .pick {
    margin-top: auto; position: relative; display: inline-flex; justify-content: center; align-items: center; min-height: 52px; border-radius: 999px;
    font-weight: 700; text-decoration: none; border: 2px solid currentColor; color: inherit; transition: transform .2s ease, background-color .2s ease;
  }
  .pick:hover { transform: translateY(-3px); }
  .featured .pick { background: var(--yellow); color: var(--ink); border-color: var(--yellow); }

  .compare { margin-top: clamp(40px, 5vw, 64px); overflow-x: auto; border-radius: 24px; border: 2px solid var(--ink); background: #FFFFFF; }
  table { width: 100%; border-collapse: collapse; min-width: 560px; font-size: .97rem; }
  th, td { text-align: left; padding: 14px 18px; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  thead th { font: 500 .75rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  tbody th { font-weight: 600; }
  .hl { background: color-mix(in srgb, var(--yellow) 30%, transparent); font-weight: 700; }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    .card.featured { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pick { transition: none; }
  }
</style>
