---
import { totales as cifras } from '../../data/agencia';

const fmt = (n: number, d: number) => n.toLocaleString('es-CO', { minimumFractionDigits: d, maximumFractionDigits: d });
---

<section class="numbers" aria-labelledby="cifras-title">
  <div class="wrap intro">
    <span class="eyebrow" data-fade>Viralizando y posicionando marcas en el mercado</span>
    <h2 id="cifras-title" data-split>Millones de personas<br />ya vieron a nuestros clientes.</h2>
  </div>
  <div class="wrap grid">
    {cifras.map((c, i) => (
      <div class="cell" style={`--bg: ${c.bg}; --fg: ${c.fg}`} data-cell>
        <b data-count={c.valor} data-decimals={c.decimales} data-prefix={c.prefijo ?? ''} data-suffix={c.sufijo}>
          {c.prefijo ?? ''}{fmt(c.valor, c.decimales)}{c.sufijo}
        </b>
        <span>{c.texto}</span>
        <i class={`deco d${i}`} aria-hidden="true"></i>
      </div>
    ))}
  </div>
</section>

<style>
  .numbers { padding-block: clamp(32px, 4vw, 56px); }
  .intro { display: grid; gap: 18px; margin-bottom: clamp(28px, 4vw, 48px); }
  .intro h2 { font-size: clamp(2.4rem, 5.6vw, 5.4rem); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cell {
    position: relative; overflow: hidden; background: var(--bg); color: var(--fg); border-radius: 32px;
    padding: clamp(24px, 3vw, 40px); min-height: 300px; display: flex; flex-direction: column; justify-content: flex-end; gap: 10px;
  }
  .cell b { white-space: nowrap; font: 800 clamp(2.6rem, 4.8vw, 5rem)/.9 var(--font-display); letter-spacing: -0.05em; font-variant-numeric: tabular-nums; position: relative; z-index: 1; }
  .cell span { font-size: 1.05rem; max-width: 22ch; position: relative; z-index: 1; font-weight: 600; }
  .deco { position: absolute; width: 46%; aspect-ratio: 1; top: -8%; right: -8%; }
  .d0 { background: #0B0B0B; border-radius: 0 0 0 100%; }
  .d1 { background: #FF9FCB; border-radius: 50%; }
  .d2 { background: #1FC99A; border-radius: 100% 0 100% 0; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .cell { min-height: 220px; }
  }
</style>
