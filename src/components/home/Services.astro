---
import Mosaic, { type Tile } from './Mosaic.astro';

const servicios: { titulo: string; texto: string; color: string; tiles: Tile[] }[] = [
  {
    titulo: 'Estrategia de contenido',
    texto: 'Estudiamos tu nicho y definimos qué contar para que la cuenta crezca y tu marca gane autoridad.',
    color: '#FFC21A',
    tiles: [{ shape: 'quarter', color: '#0B0B0B', bg: '#FFC21A' }, { shape: 'dot', color: '#FFC21A', bg: '#0B0B0B' }],
  },
  {
    titulo: 'Grabación en tu local',
    texto: 'Vamos a tu negocio varias veces al mes y grabamos todo con enfoque estratégico.',
    color: '#2F5BFF',
    tiles: [{ shape: 'circle', color: '#2F5BFF' }, { shape: 'half', color: '#FF9FCB', bg: '#2F5BFF', rot: 180 }],
  },
  {
    titulo: 'Edición de reels',
    texto: 'Cortes, textos y ritmo pensados para retener al espectador desde el primer segundo.',
    color: '#FF4D2E',
    tiles: [{ shape: 'leaf', color: '#FF4D2E' }, { shape: 'ring', color: '#0B0B0B', bg: '#FF4D2E' }],
  },
  {
    titulo: 'Publicación',
    texto: 'Publicamos cada video en Instagram y TikTok con el formato y la descripción correctos.',
    color: '#1FC99A',
    tiles: [{ shape: 'half', color: '#1FC99A', rot: 90 }, { shape: 'quarter', color: '#FFC21A', bg: '#1FC99A', rot: 180 }],
  },
  {
    titulo: 'Recomendación con Fabio Parra',
    texto: 'Un video con @Fabio Parra para llevar tu marca a su público y atraer más gente a tu local.',
    color: '#FF9FCB',
    tiles: [{ shape: 'circle', color: '#FF9FCB', bg: '#0B0B0B' }, { shape: 'leaf', color: '#2F5BFF', rot: 90 }],
  },
];
---

<section class="services" id="servicios">
  <div class="wrap head">
    <span class="eyebrow" data-fade>Servicios</span>
    <h2 data-split>Todo lo que tu marca<br />necesita para verse.</h2>
  </div>
  <ol class="list">
    {servicios.map((s, i) => (
      <li class="row" style={`--c: ${s.color}`} data-service>
        <div class="wrap inner">
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.titulo}</h3>
          <p>{s.texto}</p>
          <Mosaic tiles={s.tiles} cols={2} class="mini" />
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .services { padding-top: clamp(72px, 10vw, 140px); }
  .head { display: grid; gap: 18px; margin-bottom: clamp(36px, 5vw, 64px); }
  h2 { font-size: clamp(2.6rem, 6.6vw, 6.4rem); }
  .list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .row { position: relative; border-bottom: 2px solid var(--ink); overflow: hidden; isolation: isolate; }
  .row::before {
    content: ""; position: absolute; inset: 0; background: var(--c); z-index: -1;
    transform: scaleY(0); transform-origin: bottom; transition: transform .45s cubic-bezier(.2,.8,.2,1);
  }
  .row:hover::before { transform: scaleY(1); }
  .inner { display: grid; grid-template-columns: 70px minmax(0, 1.4fr) minmax(0, 1fr) 120px; gap: clamp(16px, 3vw, 40px); align-items: center; padding-block: clamp(22px, 3vw, 36px); }
  .n { font: 500 .9rem var(--font-mono); letter-spacing: .1em; }
  h3 { font-size: clamp(1.9rem, 4.2vw, 3.8rem); letter-spacing: -0.04em; }
  .row p { color: var(--muted); max-width: 40ch; transition: color .3s ease; }
  .row:hover p { color: var(--ink); }
  .inner :global(.mini) { width: 120px; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
  .row:hover .inner :global(.mini) { transform: rotate(90deg); }

  @media (max-width: 900px) {
    .inner { grid-template-columns: 44px minmax(0, 1fr) 72px; row-gap: 10px; }
    .n { grid-row: 1; }
    h3 { grid-column: 2; }
    .inner :global(.mini) { width: 72px; grid-column: 3; grid-row: 1 / span 2; }
    .row p { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .row::before, .inner :global(.mini), .row p { transition: none; }
  }
</style>
