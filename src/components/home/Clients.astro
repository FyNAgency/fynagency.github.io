---
import { Image } from 'astro:assets';
import { casos } from '../../data/agencia';
---

<section class="clients" aria-labelledby="clientes-title">
  <div class="wrap head">
    <span class="eyebrow" data-fade>Clientes</span>
    <h2 id="clientes-title" data-split>Empresas que han<br />confiado en nosotros.</h2>
  </div>
  <ul class="wrap logos">
    {casos.map((c) => (
      <li class="logo" style={`--c: ${c.color}`} data-client>
        <span class="ring"><Image src={c.logo} alt={`Logo de ${c.nombre}`} width={240} /></span>
        <b>{c.nombre}</b>
        <small>{c.tipo}</small>
      </li>
    ))}
  </ul>
</section>

<style>
  .clients { padding-block: clamp(64px, 9vw, 120px); }
  .head { display: grid; gap: 18px; margin-bottom: clamp(32px, 4vw, 56px); }
  h2 { font-size: clamp(2.4rem, 5.6vw, 5.4rem); }
  .logos { list-style: none; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 32px); }
  .logo { display: grid; justify-items: center; text-align: center; gap: 8px; min-width: 0; }
  .ring {
    display: block; width: min(200px, 100%); aspect-ratio: 1; border-radius: 50%; padding: 8px; background: var(--c);
    transition: transform .4s cubic-bezier(.2,.8,.2,1);
  }
  .ring :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .logo:hover .ring { transform: rotate(-8deg) scale(1.05); }
  b { font: 800 clamp(1.15rem, 1.6vw, 1.5rem)/1.1 var(--font-display); letter-spacing: -0.02em; margin-top: 8px; }
  small { font: 500 .72rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }

  @media (max-width: 760px) {
    .logos { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring { transition: none; }
  }
</style>
