---
import { opcionesInteres } from '../data/agencia';

interface Props {
  /** Prefix for field ids, so the form can appear on more than one page. */
  idPrefix?: string;
  titulo?: string;
}

const { idPrefix = 'cf', titulo = 'Cuéntanos de tu negocio' } = Astro.props;
const id = (campo: string) => `${idPrefix}-${campo}`;
---

<form
  class="form"
  name="contacto"
  method="POST"
  data-netlify="true"
  netlify-honeypot="sitio"
  data-contact-form
  novalidate
>
  <input type="hidden" name="form-name" value="contacto" />
  <p class="hp" aria-hidden="true"><label>No llenar <input name="sitio" tabindex="-1" autocomplete="off" /></label></p>

  <h2>{titulo}</h2>
  <p class="help">Déjanos tus datos y te escribimos por WhatsApp. Los campos con * son obligatorios.</p>

  <div class="fields">
    <div class="field">
      <label for={id('nombre')}>Tu nombre *</label>
      <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={id('negocio')}>Nombre del negocio *</label>
      <input id={id('negocio')} name="negocio" type="text" autocomplete="organization" required />
    </div>
    <div class="field">
      <label for={id('telefono')}>WhatsApp *</label>
      <input id={id('telefono')} name="telefono" type="tel" autocomplete="tel" inputmode="tel" placeholder="300 123 4567" required />
    </div>
    <div class="field">
      <label for={id('correo')}>Correo</label>
      <input id={id('correo')} name="correo" type="email" autocomplete="email" />
    </div>
    <div class="field">
      <label for={id('ciudad')}>Ciudad</label>
      <input id={id('ciudad')} name="ciudad" type="text" autocomplete="address-level2" placeholder="Cali" />
    </div>
    <div class="field">
      <label for={id('redes')}>Instagram o TikTok del negocio</label>
      <input id={id('redes')} name="redes" type="text" placeholder="@tunegocio" />
    </div>
    <div class="field wide">
      <label for={id('interes')}>¿Qué te interesa?</label>
      <select id={id('interes')} name="interes" data-interes>
        <option value="">Aún no sé, quiero asesoría</option>
        {opcionesInteres.map((o) => <option value={o}>{o}</option>)}
      </select>
    </div>
    <div class="field wide">
      <label for={id('mensaje')}>Mensaje</label>
      <textarea id={id('mensaje')} name="mensaje" rows="3"></textarea>
    </div>
  </div>

  <label class="consent" for={id('acepto')}>
    <input id={id('acepto')} name="acepto" type="checkbox" value="si" required />
    <span>Autorizo a F&amp;N Agency a usar estos datos para contactarme, según la <a href="/privacidad">política de privacidad</a>. *</span>
  </label>

  <p class="error" role="alert" hidden data-error></p>

  <button class="send" type="submit" data-send disabled>Enviar datos</button>
  <p class="hint" data-hint>Marca la autorización para activar el botón.</p>

  <dialog class="sent" aria-labelledby={id('sent-title')} data-sent>
    <span class="sent-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </span>
    <h3 id={id('sent-title')}>¡Mensaje enviado!</h3>
    <p>Recibimos tus datos. Te escribiremos muy pronto.</p>
    <div class="sent-actions">
      <a class="sent-go" href="/servicios">Ir a servicios</a>
      <button class="sent-close" type="button" data-close>Cerrar</button>
    </div>
  </dialog>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const send = form.querySelector<HTMLButtonElement>('[data-send]')!;
    const sent = form.querySelector<HTMLDialogElement>('[data-sent]')!;
    const hint = form.querySelector<HTMLElement>('[data-hint]')!;
    const acepto = form.querySelector<HTMLInputElement>('input[name="acepto"]')!;

    // the send button only works once the privacy authorization is checked
    const syncSend = () => {
      send.disabled = !acepto.checked;
      hint.hidden = acepto.checked;
    };
    acepto.addEventListener('change', syncSend);
    syncSend();

    // a "?interes=…" in the URL (from a package button) preselects the option
    const elegido = new URLSearchParams(location.search).get('interes');
    const select = form.querySelector<HTMLSelectElement>('[data-interes]');
    if (elegido && select && [...select.options].some((o) => o.value === elegido)) select.value = elegido;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const valor = (k: string) => String(data.get(k) ?? '').trim();

      const faltan: string[] = [];
      if (!valor('nombre')) faltan.push('tu nombre');
      if (!valor('negocio')) faltan.push('el nombre del negocio');
      if (valor('telefono').replace(/\D/g, '').length < 7) faltan.push('un WhatsApp válido');
      if (!data.get('acepto')) faltan.push('aceptar la política de privacidad');
      if (faltan.length) {
        error.textContent = `Para enviar, falta ${faltan.join(', ')}.`;
        error.hidden = false;
        return;
      }
      error.hidden = true;

      send.disabled = true;
      send.textContent = 'Enviando…';
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        window.dataLayer?.push({ event: 'formulario_enviado', interes: valor('interes') || 'asesoria' });
        sent.showModal();
      } catch {
        error.textContent = 'No pudimos enviar tus datos. Revisa tu conexión e inténtalo de nuevo.';
        error.hidden = false;
        send.textContent = 'Enviar datos';
        syncSend();
      }
    });

    // closing the confirmation (button or Esc) reloads the page with a clean form
    form.querySelector('[data-close]')!.addEventListener('click', () => sent.close());
    sent.addEventListener('close', () => window.location.reload());
  });

  declare global {
    interface Window { dataLayer?: Record<string, unknown>[] }
  }
</script>

<style>
  .form { background: var(--ink); color: #FFFFFF; border-radius: 32px; padding: clamp(26px, 3.4vw, 44px); display: grid; gap: 14px; min-width: 0; }
  h2 { font-size: clamp(2rem, 3.4vw, 3rem); }
  .help { color: #BDBDBD; }
  .hp { position: absolute; left: -9999px; }
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 14px; }
  .field { display: grid; gap: 6px; min-width: 0; }
  .wide { grid-column: 1 / -1; }
  label { font-weight: 600; }
  input:not([type="checkbox"]), select, textarea {
    width: 100%; min-height: 50px; border-radius: 14px; border: 1.5px solid #3A3A3A; background: #1A1A1A; color: #FFFFFF;
    font: 400 1rem var(--font-body); padding: 12px 14px;
  }
  textarea { resize: vertical; min-height: 96px; }
  input::placeholder, textarea::placeholder { color: #8A8A8A; }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--yellow); outline-offset: 1px; border-color: var(--yellow); }
  .consent { display: flex; gap: 12px; align-items: flex-start; font-weight: 400; color: #D8D8D8; font-size: .95rem; margin-top: 4px; }
  .consent input { width: 22px; height: 22px; flex: none; margin-top: 2px; accent-color: var(--yellow); }
  .consent a { color: var(--yellow); }
  .error { color: #FFB4A6; font-weight: 600; }
  .send {
    display: inline-flex; justify-content: center; align-items: center; min-height: 54px; border-radius: 999px; padding: 0 26px;
    background: var(--yellow); color: var(--ink); border: 0; font: 700 1.02rem var(--font-body); cursor: pointer; text-decoration: none;
    transition: background-color .2s ease, transform .2s ease;
  }
  .send:hover { background: #FFFFFF; transform: translateY(-2px); }
  .send:disabled { opacity: .45; cursor: not-allowed; transform: none; background: var(--yellow); }
  .hint { color: #BDBDBD; font-size: .9rem; margin-top: -6px; }
  .sent {
    width: min(440px, calc(100vw - 32px)); border: 0; border-radius: 28px; padding: clamp(26px, 4vw, 40px);
    background: #FFFFFF; color: var(--ink); text-align: center; box-shadow: 0 40px 90px -30px rgba(11, 11, 11, .6);
  }
  .sent[open] { display: grid; gap: 14px; justify-items: center; animation: pop .35s cubic-bezier(.2, .9, .3, 1.2); }
  .sent::backdrop { background: rgba(11, 11, 11, .6); }
  .sent-icon { width: 68px; height: 68px; border-radius: 50%; background: var(--mint); color: var(--ink); display: grid; place-items: center; }
  .sent-icon svg { width: 34px; height: 34px; }
  .sent h3 { font-size: clamp(1.8rem, 4vw, 2.3rem); }
  .sent p { color: var(--muted); }
  .sent-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  .sent-go, .sent-close {
    display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 24px; border-radius: 999px;
    font: 700 1rem var(--font-body); text-decoration: none; cursor: pointer; border: 2px solid var(--ink);
  }
  .sent-go { background: var(--ink); color: #FFFFFF; }
  .sent-go:hover { background: var(--blue); border-color: var(--blue); }
  .sent-close { background: #FFFFFF; color: var(--ink); }
  .sent-close:hover { background: var(--yellow); }
  @keyframes pop { from { opacity: 0; transform: translateY(20px) scale(.94); } }
  @media (max-width: 640px) {
    .fields { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .send { transition: none; }
    .sent[open] { animation: none; }
  }
</style>
