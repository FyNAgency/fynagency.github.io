---
import { condiciones } from '../data/propuesta';
---

<section class="block" id="pagos">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Condiciones</span>
        <h2>Método de pago.</h2>
      </div>
      <p>Pagos divididos en dos partes para que empecemos rápido y con confianza.</p>
    </div>
    <div class="terms">
      {condiciones.map((c) => (
        <div class="term">
          <h3>{c.titulo}</h3>
          <div class="split" aria-hidden="true">
            {c.partes.map((w) => <span style={`width:${w}%`}></span>)}
          </div>
          <div class="legend">
            <span><b>{c.izquierda[0]}</b> {c.izquierda[1]}</span>
            <span>{c.derecha[0] && <b>{c.derecha[0]}</b>} {c.derecha[1]}</span>
          </div>
          <p class="note">{c.nota}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .terms { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .term { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 24px; min-width: 0; }
  .term h3 { font-size: 1.2rem; font-weight: 700; }
  .split { display: flex; height: 10px; border-radius: 99px; overflow: hidden; margin: 18px 0 10px; background: var(--line); }
  .split span:first-child { background: var(--ink); }
  .split span:last-child { background: var(--aji); }
  .legend { display: flex; justify-content: space-between; gap: 12px; font-size: .88rem; color: var(--muted); }
  .legend b { color: var(--ink); }
  .note { margin-top: 12px; font-size: .92rem; color: var(--muted); }

  @media (max-width: 900px) {
    .terms { grid-template-columns: 1fr; }
  }
</style>
