---
import { pasos } from '../data/propuesta';
---

<section class="block" id="proceso">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Cómo trabajamos</span>
        <h2>Del plan a la publicación, nos encargamos de todo.</h2>
      </div>
      <p>Cada paquete incluye el proceso completo. Lo que cambia es cuántas visitas hacemos y cuántos videos salen al mes.</p>
    </div>
    <ol class="steps">
      {pasos.map((paso, i) => (
        <li class="step">
          <span class="n">PASO {i + 1}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paso.icono} />
          <h3>{paso.titulo}</h3>
          <p>{paso.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; list-style: none; padding: 0; margin: 0; }
  .step { border-top: 2px solid var(--ink); padding-top: 18px; min-width: 0; }
  .n { font-family: var(--font-mono); font-size: .8rem; color: var(--muted); letter-spacing: .1em; }
  .step svg { width: 30px; height: 30px; margin: 14px 0 12px; display: block; color: var(--ink); }
  .step h3 { font-size: 1.35rem; font-weight: 700; }
  .step p { color: var(--muted); margin-top: 8px; font-size: .98rem; }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr 1fr; row-gap: 36px; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
