---
import { Image } from 'astro:assets';
import logoNegro from '../assets/logo-negro.png';
import logoBlanco from '../assets/logo-blanco.png';

interface Props {
  /** Logo height in px. */
  height?: number;
  /** Small label next to the mark, e.g. "agency". */
  label?: string;
  /** "auto" swaps black/white with the theme; "negro" always shows the black mark. */
  variant?: 'auto' | 'negro';
  alt?: string;
}

const { height = 34, label, variant = 'auto', alt = 'F&N agency' } = Astro.props;
---

<span class:list={['logo', { auto: variant === 'auto' }]} style={`--logo-h: ${height}px`}>
  <Image class="logo-light" src={logoNegro} alt={alt} width={Math.round(height * 2.4 * 2)} />
  {variant === 'auto' && <Image class="logo-dark" src={logoBlanco} alt={alt} width={Math.round(height * 2.4 * 2)} />}
  {label && <small>{label}</small>}
</span>

<style>
  .logo { display: flex; align-items: flex-end; gap: 10px; }
  .logo :global(img) { height: var(--logo-h); width: auto; display: block; }
  .logo :global(.logo-dark) { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .logo.auto :global(.logo-light) { display: none; }
    :global(:root:not([data-theme="light"])) .logo.auto :global(.logo-dark) { display: block; }
  }
  :global(:root[data-theme="dark"]) .logo.auto :global(.logo-light) { display: none; }
  :global(:root[data-theme="dark"]) .logo.auto :global(.logo-dark) { display: block; }
  small { font-family: var(--font-mono); font-weight: 400; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
</style>
