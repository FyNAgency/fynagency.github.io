---
import Layout from '../layouts/Layout.astro';
import '../styles/propuesta.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Results from '../components/Results.astro';
import Process from '../components/Process.astro';
import Plans from '../components/Plans.astro';
import FabioParra from '../components/FabioParra.astro';
import Payment from '../components/Payment.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Propuesta F&N Agency"
  description="Estrategia, grabación, edición y publicación de videos para tu negocio. Conoce nuestros paquetes y resultados reales."
  shareDescription="Contenido que hace crecer tu negocio. Mira los paquetes, los resultados y escríbenos por WhatsApp."
>
  <Header />
  <main>
    <Hero />
    <Results />
    <Process />
    <Plans />
    <FabioParra />
    <Payment />
    <Closing />
  </main>
  <Footer />
</Layout>
