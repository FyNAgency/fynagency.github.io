---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import Mosaic, { type Tile } from '../components/home/Mosaic.astro';
import { contacto, whatsappUrl, paquetes } from '../data/propuesta';

const tiles: Tile[] = [
  { shape: 'circle', color: '#2F5BFF' },
  { shape: 'quarter', color: '#FFC21A', rot: 90 },
  { shape: 'leaf', color: '#FF4D2E', bg: '#0B0B0B' },
  { shape: 'half', color: '#1FC99A' },
];
---

<Layout
  title="Contacto · F&N Agency"
  description="Escríbele a F&N Agency por WhatsApp para grabar contenido para tu negocio en Cali."
  shareDescription="Escríbenos por WhatsApp y agendamos la primera grabación en tu negocio."
>
  <HomeHeader current="contacto" />
  <main>
    <section class="c-hero" data-hero>
      <div class="wrap grid">
        <div class="intro">
          <span class="eyebrow" data-fade>Contacto</span>
          <h1 data-split>Hablemos de<br /><span class="hl">tu negocio.</span></h1>
          <p class="lede" data-fade>Cuéntanos qué tienes en mente. Te respondemos por WhatsApp y agendamos la primera visita a tu local.</p>

          <div class="channels" data-fade>
            <a class="channel wa" href={whatsappUrl(contacto.mensajeBase)} target="_blank" rel="noopener">
              <span class="ch-label">WhatsApp</span>
              <span class="ch-value">{contacto.telefonoVisible}</span>
            </a>
            <div class="channel">
              <span class="ch-label">Dónde estamos</span>
              <span class="ch-value">Cali, Colombia</span>
            </div>
          </div>
          <Mosaic tiles={tiles} cols={4} class="c-mosaic" />
        </div>

        <form class="form" id="contact-form" novalidate>
          <h2>Escríbenos</h2>
          <p class="form-help">Al enviar, se abre WhatsApp con tu mensaje listo.</p>

          <label for="cf-nombre">Tu nombre</label>
          <input id="cf-nombre" name="nombre" type="text" autocomplete="name" required />

          <label for="cf-negocio">Nombre de tu negocio</label>
          <input id="cf-negocio" name="negocio" type="text" autocomplete="organization" required />

          <label for="cf-paquete">Paquete que te interesa</label>
          <select id="cf-paquete" name="paquete">
            <option value="">Aún no sé</option>
            {paquetes.map((p) => <option value={p.nombre}>{p.nombre} · {p.videosMes} videos al mes</option>)}
            <option value="Video con Fabio Parra">Video con Fabio Parra</option>
          </select>

          <label for="cf-mensaje">Mensaje <span class="opt">(opcional)</span></label>
          <textarea id="cf-mensaje" name="mensaje" rows="4"></textarea>

          <p class="form-error" id="cf-error" role="alert" hidden>Escribe tu nombre y el de tu negocio para continuar.</p>

          <button class="btn btn-ink" type="submit">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.7-.3-1.4-.7-2-1.3-.5-.5-1-1.1-1.3-1.7-.1-.2 0-.4.1-.5l.4-.5.3-.4v-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3c-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 1.8.8 2.5.8 3.4.7.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.5-.3z" /></svg>
            Enviar por WhatsApp
          </button>
        </form>
      </div>
    </section>
  </main>
  <HomeFooter />
</Layout>

<script>
  import '../scripts/home-motion.ts';
  import { whatsappUrl } from '../data/propuesta';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const error = document.getElementById('cf-error');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nombre = String(data.get('nombre') ?? '').trim();
    const negocio = String(data.get('negocio') ?? '').trim();
    const paquete = String(data.get('paquete') ?? '').trim();
    const mensaje = String(data.get('mensaje') ?? '').trim();

    if (!nombre || !negocio) {
      if (error) error.hidden = false;
      (form.querySelector<HTMLInputElement>(!nombre ? '#cf-nombre' : '#cf-negocio'))?.focus();
      return;
    }
    if (error) error.hidden = true;

    const lineas = [
      `Hola F&N, soy ${nombre} de ${negocio}.`,
      paquete ? `Me interesa: ${paquete}.` : 'Quiero saber más sobre sus servicios.',
      mensaje,
    ].filter(Boolean);
    window.location.href = whatsappUrl(lineas.join('\n'));
  });
</script>

<style>
  .c-hero { padding-top: 130px; padding-bottom: clamp(72px, 10vw, 140px); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .intro { display: grid; gap: 26px; justify-items: start; min-width: 0; }
  h1 { font-size: clamp(3rem, 8.4vw, 8.4rem); }
  .hl { position: relative; display: inline-block; isolation: isolate; white-space: nowrap; }
  .hl::after { content: ""; position: absolute; left: -.04em; right: -.04em; bottom: .06em; height: .26em; background: var(--mint); z-index: -1; transform-origin: left; transform: scaleX(var(--hl, 1)); }
  .lede { font-size: clamp(1.05rem, 1.4vw, 1.25rem); color: var(--muted); max-width: 44ch; }
  .channels { display: flex; gap: 14px; flex-wrap: wrap; }
  .channel { display: grid; gap: 4px; padding: 18px 22px; border-radius: 22px; border: 2px solid var(--ink); text-decoration: none; min-width: 220px; }
  .channel.wa { background: var(--yellow); border-color: var(--yellow); transition: transform .2s ease; }
  .channel.wa:hover { transform: translateY(-3px); }
  .ch-label { font: 500 .72rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .wa .ch-label { color: var(--ink); }
  .ch-value { font: 800 1.4rem/1.1 var(--font-display); letter-spacing: -0.02em; }
  .intro :global(.c-mosaic) { width: min(320px, 70%); margin-top: 10px; }

  .form {
    background: var(--ink); color: #FFFFFF; border-radius: 32px; padding: clamp(26px, 3.4vw, 44px);
    display: grid; gap: 10px; position: sticky; top: 100px;
  }
  .form h2 { font-size: clamp(2rem, 3.4vw, 3rem); }
  .form-help { color: #BDBDBD; margin-bottom: 10px; }
  label { font-weight: 600; margin-top: 8px; }
  .opt { font-weight: 400; color: #BDBDBD; }
  input, select, textarea {
    width: 100%; min-height: 50px; border-radius: 14px; border: 1.5px solid #3A3A3A; background: #1A1A1A; color: #FFFFFF;
    font: 400 1rem var(--font-body); padding: 12px 14px;
  }
  textarea { resize: vertical; min-height: 110px; }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--yellow); outline-offset: 1px; border-color: var(--yellow); }
  .form-error { color: #FFB4A6; font-weight: 600; margin-top: 6px; }
  .form .btn { margin-top: 14px; justify-content: center; background: var(--yellow); color: var(--ink); border-color: var(--yellow); cursor: pointer; font-family: var(--font-body); }
  .form .btn:hover { background: #FFFFFF; border-color: #FFFFFF; }

  @media (max-width: 900px) {
    .c-hero { padding-top: 100px; }
    .grid { grid-template-columns: 1fr; }
    .form { position: static; }
    .channel { min-width: 0; flex: 1 1 200px; }
  }
</style>
