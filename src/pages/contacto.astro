---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import Mosaic, { type Tile } from '../components/home/Mosaic.astro';
import ContactForm from '../components/ContactForm.astro';
import { contacto, whatsappUrl } from '../data/agencia';

const tiles: Tile[] = [
  { shape: 'circle', color: '#2F5BFF' },
  { shape: 'quarter', color: '#FFC21A', rot: 90 },
  { shape: 'leaf', color: '#FF4D2E', bg: '#0B0B0B' },
  { shape: 'half', color: '#1FC99A' },
];
---

<Layout
  title="Contacto · F&N Agency"
  description="Escríbele a F&N Agency y cuéntanos de tu negocio: redes sociales, sitio web, animación y logos en Cali."
  shareDescription="Escríbenos por WhatsApp y agendamos la primera grabación en tu negocio."
>
  <HomeHeader current="contacto" />
  <main>
    <section class="c-hero" data-hero>
      <div class="wrap grid">
        <div class="intro">
          <span class="eyebrow" data-fade>Contacto</span>
          <h1 data-split>Hablemos de<br /><span class="hl">tu negocio.</span></h1>
          <p class="lede" data-fade>Déjanos los datos de tu negocio y te contactamos por WhatsApp para armar la estrategia que te saque del anonimato.</p>

          <div class="channels" data-fade>
            <a class="channel wa" href={whatsappUrl(contacto.mensajeBase)} target="_blank" rel="noopener">
              <span class="ch-label">WhatsApp</span>
              <span class="ch-value">{contacto.telefonoVisible}</span>
            </a>
            <div class="channel">
              <span class="ch-label">Dónde estamos</span>
              <span class="ch-value">Cali, Colombia</span>
            </div>
          </div>
          <Mosaic tiles={tiles} cols={4} class="c-mosaic" />
        </div>

        <div class="form-col"><ContactForm titulo="Escríbenos" /></div>
      </div>
    </section>
  </main>
  <HomeFooter />
</Layout>

<script>
  import '../scripts/home-motion.ts';
</script>

<style>
  .c-hero { padding-top: 130px; padding-bottom: clamp(40px, 4.5vw, 64px); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .intro { display: grid; gap: 26px; justify-items: start; min-width: 0; }
  h1 { font-size: clamp(3rem, 8.4vw, 8.4rem); }
  .hl { position: relative; display: inline-block; isolation: isolate; white-space: nowrap; }
  .hl::after { content: ""; position: absolute; left: -.04em; right: -.04em; bottom: .06em; height: .26em; background: var(--mint); z-index: -1; transform-origin: left; transform: scaleX(var(--hl, 1)); }
  .lede { font-size: clamp(1.05rem, 1.4vw, 1.25rem); color: var(--muted); max-width: 44ch; }
  .channels { display: flex; gap: 14px; flex-wrap: wrap; }
  .channel { display: grid; gap: 4px; padding: 18px 22px; border-radius: 22px; border: 2px solid var(--ink); text-decoration: none; min-width: 220px; }
  .channel.wa { background: var(--yellow); border-color: var(--yellow); transition: transform .2s ease; }
  .channel.wa:hover { transform: translateY(-3px); }
  .ch-label { font: 500 .72rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .wa .ch-label { color: var(--ink); }
  .ch-value { font: 800 1.4rem/1.1 var(--font-display); letter-spacing: -0.02em; }
  .intro :global(.c-mosaic) { width: min(320px, 70%); margin-top: 10px; }

  .form-col { position: sticky; top: 100px; min-width: 0; }

  @media (max-width: 900px) {
    .c-hero { padding-top: 100px; }
    .grid { grid-template-columns: 1fr; }
    .form-col { position: static; }
    .channel { min-width: 0; flex: 1 1 200px; }
  }
</style>
