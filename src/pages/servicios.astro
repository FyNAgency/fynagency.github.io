---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import ServicesHero from '../components/home/ServicesHero.astro';
import Process from '../components/home/Process.astro';
import Packages from '../components/home/Packages.astro';
import Fabio from '../components/home/Fabio.astro';
import Payments from '../components/home/Payments.astro';
import Contact from '../components/home/Contact.astro';

---

<Layout
  title="Servicios y paquetes · F&N Agency"
  description="Servicios de F&N Agency en Cali: estrategia de redes sociales con paquetes Básico, Medio y Premium, desarrollo de sitios web, animación y logos."
  shareDescription="Paquetes de contenido mensual para tu negocio: Básico, Medio y Premium."
>
  <HomeHeader current="servicios" />
  <main>
    <ServicesHero />
    <Packages />
    <Process />
    <Fabio ctaHref="/contacto?interes=Video%20con%20Fabio%20Parra" ctaLabel="Quiero este video" />
    <Payments />
    <Contact />
  </main>
  <HomeFooter />
</Layout>

<script>
  import '../scripts/home-motion.ts';
</script>

